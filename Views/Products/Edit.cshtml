@model DotNetMvcWeb.Models.DTOs.Products.ProductUpdateDto

@{
  ViewData["Title"] = "Edit Product";
}

<h1>編輯產品</h1>

<h4>產品更新資料傳輸物件 (ProductUpdateDto) 示範表單</h4>
<hr />
<div class="row">
  <div class="col-md-6">
    <form asp-action="Edit">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <input type="hidden" asp-for="Id" />

      <div class="form-group mb-3">
        <label asp-for="Name" class="control-label fw-bold">產品名稱</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label asp-for="Price" class="control-label fw-bold">產品價格 (NT$)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label asp-for="Description" class="control-label fw-bold">產品描述</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
      </div>

      <div class="form-group mt-4">
        <input type="submit" value="儲存變更" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">返回產品列表</a>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}
