@model DotNetMvcWeb.Models.DTOs.Products.ProductResponseDto

@{
  ViewData["Title"] = "Delete Product";
}

<h1>刪除產品</h1>

<h3 class="text-danger">確定要刪除這個產品嗎？</h3>
<div>
  <h4>產品資料 (ProductResponseDto)</h4>
  <hr />
  <dl class="row">
    <dt class="col-sm-2">
      ID
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Id)
    </dd>
    <dt class="col-sm-2">
      名稱
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Name)
    </dd>
    <dt class="col-sm-2">
      價格
    </dt>
    <dd class="col-sm-10">
      <strong>@Model.FormattedPrice</strong>
    </dd>
    <dt class="col-sm-2">
      描述
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Description)
    </dd>
  </dl>

  <form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="確認刪除" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">返回列表</a>
  </form>
</div>
