@model DotNetMvcWeb.Models.DTOs.Products.ProductResponseDto

@{
  ViewData["Title"] = "Product Details";
}

<h1>產品詳細資訊</h1>

<div>
  <h4>產品資料 (ProductResponseDto)</h4>
  <hr />
  <dl class="row">
    <dt class="col-sm-2">
      ID
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Id)
    </dd>
    <dt class="col-sm-2">
      名稱
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Name)
    </dd>
    <dt class="col-sm-2">
      價格
    </dt>
    <dd class="col-sm-10">
      <strong>@Model.FormattedPrice</strong>
    </dd>
    <dt class="col-sm-2">
      描述
    </dt>
    <dd class="col-sm-10">
      @Html.DisplayFor(model => model.Description)
    </dd>
  </dl>
</div>
<div class="mt-4">
  <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">編輯</a>
  <a asp-action="Index" class="btn btn-outline-secondary ms-2">返回列表</a>
</div>
