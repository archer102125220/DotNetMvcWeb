@model IEnumerable<DotNetMvcWeb.Models.DTOs.Products.ProductResponseDto>

@{
  ViewData["Title"] = "Products";
}

<h1>產品列表 (ProductResponseDto)</h1>

<p>
  <a asp-action="Create" class="btn btn-primary">新增產品</a>
</p>
<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>
        @Html.DisplayNameFor(model => model.Id)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Name)
      </th>
      <th>
        價格 (格式化輸出)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Description)
      </th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model)
    {
      <tr>
        <td>
          @Html.DisplayFor(modelItem => item.Id)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
          <strong>@item.FormattedPrice</strong>
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
          <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編輯</a>
          <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">詳細</a>
          <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">刪除</a>
        </td>
      </tr>
    }
  </tbody>
</table>
