@model DotNetMvcWeb.Models.DTOs.Products.ProductCreateDto

@{
  ViewData["Title"] = "Create Product";
}

<h1>新增產品</h1>

<h4>產品資料傳輸物件 (ProductCreateDto) 示範表單</h4>
<p class="text-muted">
  [教學說明] 此表單綁定 <code>ProductCreateDto</code>。輸入價格為 0 或負數、未填名稱或輸入純空白字元時，會自動觸發後端驗證標籤並顯示錯誤提示。
</p>
<hr />
<div class="row">
  <div class="col-md-6">
    <form asp-action="Create">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>

      <div class="form-group mb-3">
        <label asp-for="Name" class="control-label fw-bold">產品名稱</label>
        <input asp-for="Name" class="form-control" placeholder="請輸入產品名稱 (1~100 字元)" />
        <span asp-validation-for="Name" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label asp-for="Price" class="control-label fw-bold">產品價格 (NT$)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="請輸入大於 0 的金額" />
        <span asp-validation-for="Price" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label asp-for="Description" class="control-label fw-bold">產品描述 (選填)</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="請輸入產品詳細描述 (最多 500 字)"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
      </div>

      <div class="form-group mt-4">
        <input type="submit" value="確認新增" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">返回產品列表</a>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}
