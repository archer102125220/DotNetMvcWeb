<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DotNetMvcWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/oracle-demo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DotNetMvcWeb.styles.css" asp-append-version="true" />
</head>
<body hx-indicator="#global-loading-bar">
    <div id="global-loading-bar" class="htmx-indicator"></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DotNetMvcWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        string GetActiveStyle(string c, string? a = null)
                        {
                            string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                            bool isMatch = string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
                            if (a != null)
                            {
                                isMatch = isMatch && string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase);
                            }
                            return isMatch ? "active text-primary fw-bold" : "text-dark";
                        }
                    }
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("Products")" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("OracleDemo")" asp-area="" asp-controller="OracleDemo" asp-action="Index">Oracle Demo (Items)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("OracleDemoCategory")" asp-area="" asp-controller="OracleDemoCategory" asp-action="Index">Oracle Demo (Categories)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("MysqlDemo")" asp-area="" asp-controller="MysqlDemo" asp-action="Index">MySQL Demo (Items)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("MysqlDemoCategory")" asp-area="" asp-controller="MysqlDemoCategory" asp-action="Index">MySQL Demo (Categories)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("PostgresDemo")" asp-area="" asp-controller="PostgresDemo" asp-action="Index">Postgres Demo (Items)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("PostgresDemoCategory")" asp-area="" asp-controller="PostgresDemoCategory" asp-action="Index">Postgres Demo (Categories)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("ExtensionsDemo")" asp-area="" asp-controller="ExtensionsDemo" asp-action="Index">Extensions 示範</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveStyle("Home", "Privacy")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DotNetMvcWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
