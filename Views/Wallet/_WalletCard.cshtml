@model DotNetMvcWeb.Models.ViewModels.WalletViewModel

<div class="wallet_card card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-gradient bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-white text-primary fw-bold me-2">Domain Model</span>
            <span class="fw-semibold">@Model.OwnerId 的數位錢包</span>
        </div>
        <small class="text-white-50">最後更新：@Model.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</small>
    </div>
    <div class="card-body p-4 text-center">
        <div class="text-muted small mb-1">當前可用餘額</div>
        <div class="wallet_card-balance display-4 fw-bold text-dark mb-3">
            NT$ @Model.Balance.ToString("N0")
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show text-start py-2 px-3 mb-0" role="alert">
                <i class="bi @(Model.IsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                @Model.StatusMessage
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>
</div>
