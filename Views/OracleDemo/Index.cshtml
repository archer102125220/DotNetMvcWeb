@model IEnumerable<DotNetMvcWeb.Models.OracleDemoItem>
@{
    ViewData["Title"] = "Oracle DB Demo";
}

<!--
  主頁面 (Index)：
  這裡使用了 HTMX 來處理前端與後端的非同步互動，而不需要寫任何 JavaScript。
  主要有兩個區塊：
  1. #oracle-demo-form-container：用來顯示新增或編輯表單的區塊
  2. #oracle-demo-list-container：用來顯示資料列表的區塊
-->
<div class="oracle_demo_page">
    <div class="oracle_demo_page-header d-flex justify-content-between align-items-center mb-4">
        <h1 class="oracle_demo_page-title">Oracle Database Demonstration</h1>
        
        <div class="d-flex gap-2">
            <!-- 
              搜尋框 (示範 Raw SQL 查詢)：
              透過 HTMX，當使用者輸入文字 (keyup) 並停頓 500ms 後，會發送 GET /OracleDemo/List?keyword=xxx
              並自動替換下方的列表 
            -->
            <input type="text" 
                   name="keyword" 
                   class="form-control" 
                   placeholder="搜尋名稱 (Raw SQL)..."
                   hx-get="@Url.Action("List", "OracleDemo")"
                   hx-trigger="keyup changed delay:500ms, search"
                   hx-target="#oracle-demo-list-container" />

            <!--
              【HTMX 流程解說：如何顯示新增表單】
              1. 觸發條件：使用者點擊這顆按鈕。
              2. 發送請求：hx-get 告訴 HTMX 發送一個 HTTP GET 請求到 /OracleDemo/Create (這是由 Url.Action 產生的路徑)。
              3. 後端處理：Controller 收到請求後，執行 Create() 方法，並回傳 "_CreateOrEdit.cshtml" 這個 Partial View (HTML 原始碼)。
              4. 接收與替換：HTMX 收到 HTML 原始碼後，會找到畫面上的 hx-target (也就是 id="oracle-demo-form-container" 的元素)。
              5. 渲染方式：依照 hx-swap="innerHTML" 的指示，把該元素的「內部內容」替換成後端回傳的表單 HTML。
                 (也就是說，下方預設的那段 <p>Select an item...</p> 就會被 _CreateOrEdit 的內容給蓋掉！)
            -->
            <button class="oracle_demo_page-create_btn btn btn-primary text-nowrap"
                    hx-get="@Url.Action("Create", "OracleDemo")"
                    hx-target="#oracle-demo-form-container"
                    hx-swap="innerHTML">
                Create New Item
            </button>
        </div>
    </div>

    <div class="row">
        <!-- 表單顯示區塊 (Form Container) -->
        <div class="col-md-4">
            <!--
              這就是上面 Create 按鈕 (以及列表中的 Edit 按鈕) 的目標容器 (hx-target="#oracle-demo-form-container")。
              這是一個非常重要的 HTMX 概念：我們不需要寫 JS 操作 DOM，只要指定目標 ID，
              HTMX 就會自動把後端回傳的 Partial View (_CreateOrEdit.cshtml) 塞進這裡！
            -->
            <div id="oracle-demo-form-container" class="oracle_demo_page-form_container card p-3 shadow-sm">
                <!-- 預設狀態下的提示文字，當點擊「新增」或「編輯」時，這整段 <p> 會被 _CreateOrEdit.cshtml 的內容蓋掉 -->
                <p class="text-muted mb-0">Select an item to edit or click 'Create New Item'.</p>
            </div>
        </div>

        <!-- 資料列表區塊 (List Container) -->
        <div class="col-md-8">
            <div id="oracle-demo-list-container" class="oracle_demo_page-list_container">
                <!-- 初始載入時，直接透過 Razor 渲染部分視圖 (_DemoList) -->
                @await Html.PartialAsync("_DemoList", Model)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 引入 HTMX 腳本庫，讓上述的 hx-* 屬性生效 -->
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
}
