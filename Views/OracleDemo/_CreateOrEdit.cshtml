@model DotNetMvcWeb.Models.OracleDemoItem

<!--
  表單 Partial View (共用於新增與編輯)：
  這裡的表單送出是透過 HTMX 的 hx-post，而非傳統的整頁重整。
-->
<h4 class="mb-3">@(Model.Id == 0 ? "Create Item" : "Edit Item")</h4>

<!--
  根據 Model.Id 是否為 0 來決定送出的 Action 網址 (Create 或 Edit)。
  送出後，預期 Controller 會回傳更新後的資料列表，因此 hx-target 設為 #oracle-demo-list-container
-->
<form hx-post="@(Model.Id == 0 ? Url.Action("Create", "OracleDemo") : Url.Action("Edit", "OracleDemo", new { id = Model.Id }))"
      hx-target="#oracle-demo-list-container"
      hx-swap="innerHTML"
      class="oracle_demo_page-form">
    
    <!-- 必要的 CSRF 防護標記 -->
    @Html.AntiForgeryToken()

    @if (Model.Id != 0)
    {
        <!-- 如果是編輯模式，必須將 Id 與 CreatedAt 隱藏欄位帶上，以確保 Model Binding 正常 -->
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
    }

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
        <!-- 顯示伺服器端的驗證錯誤訊息 -->
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">-- Select Category (Optional) --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <!-- 取消按鈕：直接使用 JavaScript 將表單區塊還原為預設文字 -->
        <button type="button" 
                class="btn btn-light" 
                onclick="document.getElementById('oracle-demo-form-container').innerHTML = '<p class=\'text-muted mb-0\'>Select an item to edit or click \'Create New Item\'.</p>'">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
