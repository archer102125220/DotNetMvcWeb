@model IEnumerable<DotNetMvcWeb.Models.MysqlDemoItem>

@{
    ViewData["Title"] = "ADO.NET 原生查詢示範 (UI版)";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <!-- 
              [教學註解] 
              這裡使用 HTMX 達到「表單查詢」的效果。
              - hx-get: 表單送出時，攔截預設的跳轉，並使用 AJAX GET 請求到目標網址。
              - hx-target: 把回傳的結果渲染到哪裡。
              - hx-select: 從後端回傳的整頁 HTML 中，只抓出特定的區塊進行替換，不用寫 Partial View！
              - hx-replace-url: 更新瀏覽器的網址列，方便按 F5 重整或上一頁。
            -->
            <form hx-get="@Url.Action("AdoNetDemo", "MysqlDemo")"
                  hx-target="#table-container"
                  hx-select="#table-container"
                  hx-push-url="true"
                  class="input-group input-group-lg mb-4">
                
                <input type="text" 
                       name="keyword" 
                       class="form-control border-primary" 
                       placeholder="輸入名稱關鍵字搜尋 (按下 Enter 或點擊查詢)..."
                       value="@ViewBag.Keyword" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> 查詢
                </button>
            </form>

            <!-- [教學註解] 
                 這個 View 是一個典型的 MVC 強型別視圖 (Strongly-typed View)。
                 我們在檔案最上面宣告了 @@model IEnumerable<DotNetMvcWeb.Models.MysqlDemoItem>，
                 這代表傳入這個畫面的 Model 就是一個 MysqlDemoItem 的集合 (List)。
                 我們不需要知道這些資料是從 EF Core 來的，還是從 ADO.NET 原生查詢來的，
                 只要 Model 的結構正確，View 就能正常負責「渲染畫面」。這就是 MVC (Model-View-Controller) 的職責分離。
            -->
            <p class="text-muted">
                此頁面的資料是透過 <code>MySql.Data.MySqlClient</code> 以及原生 ADO.NET (<code>MySqlConnection</code>, <code>MySqlCommand</code>) 直接查詢取得，而非透過 Entity Framework Core。
            </p>

            <div id="table-container">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mt-3">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>名稱 (Name)</th>
                                <th>描述 (Description)</th>
                                <th>分類名稱 (Category Name)</th>
                                <th>建立時間 (Created At)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>@(item.Description ?? "-")</td>
                                    <td>
                                        @if (item.Category != null)
                                        {
                                            <span class="badge bg-info text-dark">@item.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">目前搜尋不到符合「@(ViewBag.Keyword)」的資料。</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <a href="@Url.Action("Index", "MysqlDemo")" class="btn btn-secondary mt-3">返回首頁列表</a>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 引入 HTMX 腳本庫，讓搜尋框的動態查詢功能生效 -->
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
}
