@{
    ViewData["Title"] = "Redirect 示範";
}

<div class="redirect_demo_page">
    <div class="container mt-5">
        <h1 class="mb-4">ASP.NET Core MVC 重新導向 (Redirect) 示範</h1>
        
        <div class="list-group">
            <a href="/RedirectDemo/ExternalRedirectDemo" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start" target="_blank">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">1. Redirect() - 302 暫時重新導向</div>
                    重新導向到外部網站 (Google)。使用 HTTP 302 Found。
                </div>
            </a>
            
            <a href="/RedirectDemo/PermanentRedirectDemo" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start" target="_blank">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">2. RedirectPermanent() - 301 永久重新導向</div>
                    永久重新導向到外部網站 (Google)。瀏覽器會快取這個導向。
                </div>
            </a>
            
            <a href="/RedirectDemo/RedirectToActionDemo" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">3. RedirectToAction() - 導向到同一個 Controller 的 Action</div>
                    導向到 TargetAction 並傳遞參數 (id=123, message=...)。
                </div>
            </a>
            
            <a href="/RedirectDemo/RedirectToOtherController" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">4. RedirectToAction() - 導向到不同 Controller 的 Action</div>
                    導向到 HomeController 的 Index 頁面。
                </div>
            </a>
            
            <a href="/RedirectDemo/LocalRedirectDemo?returnUrl=/Home/Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">5. LocalRedirect() - 安全的本地導向 (成功)</div>
                    導向到本地路由 <code>/Home/Index</code>。防範 Open Redirect 攻擊。
                </div>
            </a>
            
            <a href="/RedirectDemo/LocalRedirectDemo?returnUrl=https://www.google.com" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start text-danger">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">5.1. LocalRedirect() - 惡意的外部導向 (會拋出異常)</div>
                    嘗試用 LocalRedirect 導向到外部網站 <code>https://www.google.com</code>，這會觸發異常保護。
                </div>
            </a>

            <!-- HTMX 範例 -->
            <button hx-post="/RedirectDemo/HtmxRedirectDemo" 
                    hx-swap="none"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-start text-primary">
                <div class="ms-2 me-auto text-start">
                    <div class="fw-bold">6. HTMX 重新導向 (搭配 HX-Redirect)</div>
                    點擊發送 HTMX POST 請求，後端回傳 HX-Redirect Header，使前端進行整頁跳轉至 Home 頁面。
                </div>
            </button>
        </div>
    </div>
</div>
